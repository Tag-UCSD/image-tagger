# Image Tagger backend — Phase 1 production image (Task A-12a).
# Build context: repository root (.). See render.yaml dockerContext.

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
        libpq-dev \
        gcc \
        g++ \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY backend /app/backend

RUN groupadd --system --gid 10001 appgroup \
    && useradd --system --uid 10001 --ingroup appgroup --home /home/appuser --shell /bin/sh appuser \
    && mkdir -p /data/image_store \
    && chown -R appuser:appgroup /app /data/image_store

USER appuser

ENV IMAGE_STORAGE_ROOT=/data/image_store
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["sh", "-c", "exec uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
