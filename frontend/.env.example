# Set to "true" to use fixture data (no backend required).
# Set to "false" to hit VITE_API_BASE_URL.
VITE_USE_MOCKS=true

# Base URL for the live backend (used when VITE_USE_MOCKS=false).
VITE_API_BASE_URL=http://localhost:8000

# Pre-issued JWTs for demo access to protected routes (workbench, monitor, admin).
# Leave blank when running with mocks — only needed when VITE_USE_MOCKS=false.
VITE_DEMO_ADMIN_JWT=
VITE_DEMO_TAGGER_JWT=
VITE_DEMO_SUPERVISOR_JWT=

