# Set to "true" to use fixture data (no backend required).
# Set to "false" to hit VITE_API_BASE_URL (or the production Render default).
VITE_USE_MOCKS=true

# Base URL for the live backend (used when VITE_USE_MOCKS=false).
# Required for local dev; on Vercel production builds this falls back to
# https://image-tagger-backend.onrender.com when unset.
VITE_API_BASE_URL=http://localhost:8000

# Static demo token for protected routes (workbench, monitor, admin).
# Must match DEMO_TOKEN set in the backend environment. Never expires.
# Leave blank when running with mocks — only needed when VITE_USE_MOCKS=false.
VITE_DEMO_TOKEN=

# Optional: if set, a password prompt is shown on first load (per browser session).
VITE_DEMO_PASSWORD=

