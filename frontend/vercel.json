{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci --include=dev",
  "framework": null,
  "rewrites": [
    { "source": "/v1/:path*", "destination": "https://image-tagger-backend.onrender.com/v1/:path*" },
    { "source": "/health", "destination": "https://image-tagger-backend.onrender.com/health" },
    { "source": "/static/:path*", "destination": "https://image-tagger-backend.onrender.com/static/:path*" },
    { "source": "/workbench",        "destination": "/workbench/index.html" },
    { "source": "/workbench/:path*", "destination": "/workbench/index.html" },
    { "source": "/monitor",          "destination": "/monitor/index.html" },
    { "source": "/monitor/:path*",   "destination": "/monitor/index.html" },
    { "source": "/admin",            "destination": "/admin/index.html" },
    { "source": "/admin/:path*",     "destination": "/admin/index.html" },
    { "source": "/",                 "destination": "/explorer/index.html" },
    { "source": "/:path*",           "destination": "/explorer/index.html" }
  ]
}
