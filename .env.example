# Image Tagger — local environment template (Task A-1)
#
# Copy this file to `.env` and fill in values for local development:
#     cp .env.example .env
#
# The canonical list of shared names lives in /docs/CONTRACT.md.
# Production deployments must populate every variable marked "REQUIRED
# IN PRODUCTION" via the platform secret store (Render/Supabase/GitHub
# Actions). Missing required values cause `backend.main:app` to abort
# in its lifespan startup with a clear error message.

# ---------------------------------------------------------------------------
# Environment selector
# One of: development | staging | production
# ---------------------------------------------------------------------------
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Database (REQUIRED IN PRODUCTION)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://tagger:changeme@localhost:5432/image_tagger_v3

# ---------------------------------------------------------------------------
# Supabase Auth
# SUPABASE_JWT_SECRET is REQUIRED IN PRODUCTION (used in Task A-3 to verify
# bearer JWTs). SUPABASE_URL / SUPABASE_ANON_KEY are consumed by the
# frontend via their VITE_* counterparts — set them if you run the
# frontend against a live Supabase project locally.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------------------
# Image storage
# Path (absolute or relative to the repo root) where uploaded images are
# written. In Docker this is a container path and is overridden by the
# service definition.
# ---------------------------------------------------------------------------
IMAGE_STORAGE_ROOT=data_store

# ---------------------------------------------------------------------------
# CORS (REQUIRED IN PRODUCTION)
# Comma-separated list of allowed origins for the API. Empty string is
# only acceptable in development.
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------------------------------------------------------------------------
# VLM cost controls (REQUIRED IN PRODUCTION)
# Hard USD ceiling on daily VLM spend enforced by /v1/admin/budget.
# ---------------------------------------------------------------------------
VLM_HARD_LIMIT_USD=10.0

# ---------------------------------------------------------------------------
# VLM provider API keys
# Each is optional; an empty value simply disables that provider.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Observability
# LOG_LEVEL follows Python logging levels (DEBUG, INFO, WARNING, ERROR).
# SENTRY_DSN is reserved for post-Phase 1 work (see Task A-10 notes) and
# may be left blank.
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Backend-only runtime flags
# ENABLE_LEGACY_PREFIXES controls the PrefixStripMiddleware in
# backend/main.py, which rewrites `/api/v1/tagger/...` and `/api/...`
# incoming paths to the canonical `/v1/...` routes. Set to `0` or
# `false` to disable.
# API_SECRET is the legacy header-trust auth key used pre-A-3. It is
# intentionally unset by default — the app will reject privileged role
# requests until a value is provided or Task A-3 lands.
# ---------------------------------------------------------------------------
ENABLE_LEGACY_PREFIXES=1
API_SECRET=

# ---------------------------------------------------------------------------
# Postgres bootstrap (used by deploy/docker-compose.yml only)
# These are consumed by the `db` service to provision the dev Postgres
# container. They must match the DATABASE_URL above.
# ---------------------------------------------------------------------------
POSTGRES_USER=tagger
POSTGRES_PASSWORD=changeme
POSTGRES_DB=image_tagger_v3
